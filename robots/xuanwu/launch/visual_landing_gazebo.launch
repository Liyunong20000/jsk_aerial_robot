<launch>
  <arg name="descend" default="false" />
  <arg name="headless" default="false" />
  <arg name="spawn_x" default="0.30" />
  <arg name="spawn_y" default="0.20" />
  <arg name="spawn_z" default="0.20" />
  <arg name="spawn_yaw" default="0.35" />
  <include file="$(find xuanwu)/launch/bringup.launch">
    <arg name="descend" value="$(arg descend)" />
    <arg name="real_machine" value="false" /><arg name="simulation" value="true" />
    <arg name="headless" value="$(arg headless)" />
    <arg name="direct_model" value="true" />
    <arg name="direct_model_name" value="$(find xuanwu)/urdf/visual_landing.gazebo.xacro" />
    <arg name="visual_landing_config_file" value="$(find xuanwu)/config/visual_landing_sim.yaml" />
    <arg name="worldtype" value="$(find xuanwu)/world/visual_landing.world" />
    <arg name="spawn_x" value="$(arg spawn_x)" /><arg name="spawn_y" value="$(arg spawn_y)" />
    <arg name="spawn_z" value="$(arg spawn_z)" /><arg name="spawn_yaw" value="$(arg spawn_yaw)" />
  </include>
  <!-- Optical convention: native link +X forward, +Y left, +Z up;
       optical +X right, +Y down, +Z forward. Product gives W_R_C = I. -->
  <node pkg="tf" type="static_transform_publisher" name="ground_camera_mount_tf"
        args="0 0 0.03 0.5 -0.5 0.5 0.5 world ground_camera_link 100" />
  <node pkg="tf" type="static_transform_publisher" name="ground_camera_optical_tf"
        args="0 0 0 -0.5 0.5 -0.5 0.5 ground_camera_link ground_camera_optical_frame 100" />

  <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="ground_apriltag" output="screen">
    <rosparam file="$(find xuanwu)/config/apriltag/visual_landing_sim.yaml" command="load" />
    <remap from="image_rect" to="/ground_camera/image_raw" />
    <remap from="camera_info" to="/ground_camera/camera_info" />
    <remap from="tag_detections" to="/qilin/tag_detections" />
  </node>
  <include file="$(find xuanwu)/launch/apriltag_relative_pose.launch">
    <arg name="docking_frame" value="ground_camera_optical_frame" />
    <arg name="camera_matrix_file" value="$(find xuanwu)/config/CameraDroneMatrix_sim.yaml" />
    <arg name="tag_matrix_file" value="$(find xuanwu)/config/DroneTagsMatrix_sim.yaml" />
  </include>
</launch>
