  <library_effects>
    <effect id="Shape_407-effect">
      <profile_COMMON>
        <newparam sid="texture_jpg-surface">
          <surface type="2D">
            <init_from>texture_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="texture_jpg-sampler">
          <sampler2D>
            <source>texture_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="texture_jpg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
