<?xml version="1.0" ?>
<sdf version='1.4'>
  <world name='default'>

    <physics type='ode'>
      <max_step_size>0.0002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>5000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- A global light source -->
   <scene>
      <!-- Upward view sees the shaded underside; keep the first geometry test evenly lit. -->
      <ambient>1 1 1 1</ambient>
      <shadows>false</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
   </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>


    <model name="ground_camera">
      <static>true</static>
      <!-- Native Gazebo camera +X becomes world +Z. Combined optical axes = world axes. -->
      <pose>0 0 0.03 1.5707963267948966 -1.5707963267948966 0</pose>
      <link name="ground_camera_link">
        <sensor name="upward_camera" type="camera">
          <always_on>true</always_on><update_rate>25</update_rate>
          <camera><horizontal_fov>1.7453292519943295</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.01</near><far>20</far></clip>
          </camera>
          <plugin name="ground_camera_ros" filename="libgazebo_ros_camera.so">
            <robotNamespace>/</robotNamespace><cameraName>ground_camera</cameraName>
            <imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <!-- Sensor governs 25 Hz; do not throttle a second time in the plugin. -->
            <frameName>ground_camera_optical_frame</frameName><updateRate>0</updateRate>
            <hackBaseline>0</hackBaseline><distortionK1>0</distortionK1><distortionK2>0</distortionK2><distortionK3>0</distortionK3><distortionT1>0</distortionT1><distortionT2>0</distortionT2>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
